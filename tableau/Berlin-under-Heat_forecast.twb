            <column-instance column='[evaluation]' derivation='None' name='[none:evaluation:nk]' pivot='key' type='nominal' />
            <column-instance column='[mae_label]' derivation='None' name='[none:mae_label:nk]' pivot='key' type='nominal' />
            <column-instance column='[model]' derivation='None' name='[none:model:nk]' pivot='key' type='nominal' />
            <column-instance column='[mae]' derivation='Sum' name='[sum:mae:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <manual-sort column='[federated.bub2mp3yk3m2arasu0l7wdca3dif].[none:model:nk]' direction='ASC'>
            <dictionary>
              <bucket>&quot;Naive (last 7 days)&quot;</bucket>
              <bucket>&quot;Linear regression&quot;</bucket>
              <bucket>&quot;Random forest&quot;</bucket>
              <bucket>&quot;Gradient boosting&quot;</bucket>
            </dictionary>
          </manual-sort>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='axis'>
            <format attr='title' class='0' field='[federated.bub2mp3yk3m2arasu0l7wdca3dif].[sum:mae:qk]' scope='rows' value='Mean absolute error (missions per day)' />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Bar' />
            <encodings>
              <color column='[federated.bub2mp3yk3m2arasu0l7wdca3dif].[none:model:nk]' />
              <text column='[federated.bub2mp3yk3m2arasu0l7wdca3dif].[none:mae_label:nk]' />

            </encodings>
            <customized-tooltip>
              <formatted-text>
                <run bold='true'><![CDATA[<[federated.bub2mp3yk3m2arasu0l7wdca3dif].[none:model:nk]>]]></run>
                <run>Æ&#10;</run>
                <run><![CDATA[<[federated.bub2mp3yk3m2arasu0l7wdca3dif].[none:evaluation:nk]>]]></run>
                <run>Æ&#10;</run>
                <run>Mean absolute error: </run>
                <run bold='true'><![CDATA[<[federated.bub2mp3yk3m2arasu0l7wdca3dif].[none:mae_label:nk]>]]></run>
                <run> missions per day</run>

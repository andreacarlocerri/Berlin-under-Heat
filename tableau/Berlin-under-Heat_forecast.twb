      <aliases enabled='yes' />
      <column caption='Index vs summer baseline' datatype='real' name='[Calculation_5100000000000000001]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([ems_index]) - 100' />
      </column>
      <column caption='Label: index vs baseline' datatype='string' name='[Calculation_5100000000000000002]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_5100000000000000001] &gt;= 0 THEN &quot;+&quot; ELSE &quot;−&quot; END + STR(INT(INT(ROUND(ABS([Calculation_5100000000000000001]) * 10)) / 10)) + &quot;.&quot; + STR(INT(ROUND(ABS([Calculation_5100000000000000001]) * 10)) % 10)' />
      </column>
      <column caption='Number of days' datatype='integer' name='[Calculation_5100000000000000003]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([date])' />
      </column>
      <column caption='Index on hot days' datatype='real' name='[Calculation_5100000000000000004]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(IF [hot_day] = 1 THEN [ems_index] END)' />
      </column>
      <column caption='Index on normal days' datatype='real' name='[Calculation_5100000000000000005]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(IF [hot_day] = 0 THEN [ems_index] END)' />
      </column>
      <column caption='Hot-day effect (index points)' datatype='real' name='[Calculation_5100000000000000006]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_5100000000000000004] - [Calculation_5100000000000000005]' />
      </column>
      <column caption='Label: hot-day effect' datatype='string' name='[Calculation_5100000000000000007]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_5100000000000000006] &gt;= 0 THEN &quot;+&quot; ELSE &quot;−&quot; END + STR(INT(INT(ROUND(ABS([Calculation_5100000000000000006]) * 10)) / 10)) + &quot;.&quot; + STR(INT(ROUND(ABS([Calculation_5100000000000000006]) * 10)) % 10)' />
      </column>
      <column caption='Hot-day effect per summer (fixed)' datatype='real' name='[Calculation_5100000000000000008]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [year] : AVG(IF [hot_day] = 1 THEN [ems_index] END) - AVG(IF [hot_day] = 0 THEN [ems_index] END) }' />
      </column>
      <column caption='KPI: summers with higher demand' datatype='string' name='[Calculation_5100000000000000009]' role='measure' type='nominal'>
        <calculation class='tableau' formula='STR(COUNTD(IF [Calculation_5100000000000000008] &gt; 0 THEN [year] END)) + &quot; of &quot; + STR(COUNTD([year]))' />
      </column>
      <column caption='KPI: hot days without warning' datatype='string' name='[Calculation_5100000000000000010]' role='measure' type='nominal'>
        <calculation class='tableau' formula='STR(SUM(IF [day_type] = &quot;Hot, no warning&quot; THEN 1 ELSE 0 END)) + &quot; of &quot; + STR(SUM([hot_day]))' />
      </column>
      <column caption='KPI: correlation' datatype='string' name='[Calculation_5100000000000000011]' role='measure' type='nominal'>
        <calculation class='tableau' formula='&quot;r = &quot; + STR(ROUND(CORR([tmax], [ems_index]), 2))' />
      </column>
      <column caption='KPI: hot-day effect' datatype='string' name='[Calculation_5100000000000000012]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_5100000000000000006] &gt;= 0 THEN &quot;+&quot; ELSE &quot;−&quot; END + STR(INT(INT(ROUND(ABS([Calculation_5100000000000000006]) * 10)) / 10)) + &quot;.&quot; + STR(INT(ROUND(ABS([Calculation_5100000000000000006]) * 10)) % 10)' />
      </column>

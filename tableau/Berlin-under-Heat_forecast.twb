    <worksheet name='KPI 1 — Hot-day effect'>
      <table>
        <view>
          <datasources>
            <datasource caption='tableau_daily' name='federated.0e9422g07f646911m3q6z16lejz5' />
          </datasources>
          <datasource-dependencies datasource='federated.0e9422g07f646911m3q6z16lejz5'>
            <column caption='Index on hot days' datatype='real' name='[Calculation_5100000000000000004]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG(IF [hot_day] = 1 THEN [ems_index] END)' />
            </column>
            <column caption='Index on normal days' datatype='real' name='[Calculation_5100000000000000005]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG(IF [hot_day] = 0 THEN [ems_index] END)' />
            </column>
            <column caption='Hot-day effect (index points)' datatype='real' name='[Calculation_5100000000000000006]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_5100000000000000004] - [Calculation_5100000000000000005]' />
            </column>
            <column caption='KPI: hot-day effect' datatype='string' name='[Calculation_5100000000000000012]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_5100000000000000006] &gt;= 0 THEN &quot;+&quot; ELSE &quot;−&quot; END + STR(INT(INT(ROUND(ABS([Calculation_5100000000000000006]) * 10)) / 10)) + &quot;.&quot; + STR(INT(ROUND(ABS([Calculation_5100000000000000006]) * 10)) % 10)' />
            </column>
            <column caption='EMS demand index' datatype='real' name='[ems_index]' role='measure' type='quantitative' />
            <column caption='Hot day (0/1)' datatype='integer' name='[hot_day]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_5100000000000000012]' derivation='User' name='[usr:Calculation_5100000000000000012:nk]' pivot='key' type='nominal' />

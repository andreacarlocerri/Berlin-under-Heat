    <dashboard name='Berlin Under Heat'>
      <style />
      <size sizing-mode='automatic' />
      <zones>
        <zone h='100000' id='2' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='100000' id='16' param='vert' type-v2='layout-flow' w='100000' x='0' y='0'>
            <zone fixed-size='66' h='11078' id='3' is-fixed='true' type-v2='text' w='100000' x='0' y='0'>
              <formatted-text>
                <run fontcolor='#000000' fontname='Benton Sans Book' fontsize='20'>Berlin Under Heat</run>
                <run>Æ&#10;</run>
                <run fontcolor='#79706e' fontsize='11'>Hot days (≥30°C, DWD Berlin-Tempelhof) and Berlin Fire Brigade emergency medical (EMS) missions · June–August 2018–2026 · 822 days</run>
              </formatted-text>
              <layout-cache fixed-size-h='66' minwidth='0' type-h='fixed' type-w='scalable' />
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='4' />
              </zone-style>
            </zone>
            <zone fixed-size='100' h='14970' id='8' is-fixed='true' param='horz' type-v2='layout-flow' w='100000' x='0' y='11078'>
              <layout-cache fixed-size-h='100' minwidth='0' type-h='fixed' type-w='scalable' />
              <zone h='14970' id='4' name='KPI 1 — Hot-day effect' show-title='false' w='25000' x='0' y='11078'>

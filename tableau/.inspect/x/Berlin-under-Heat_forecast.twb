    <worksheet name='Live Demo — Warning coverage by year'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#000000' fontname='Tableau Book'>Hot days without a warning, by summer</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='tableau_daily' name='federated.0e9422g07f646911m3q6z16lejz5' />
          </datasources>
          <datasource-dependencies datasource='federated.0e9422g07f646911m3q6z16lejz5'>
            <column caption='Number of days' datatype='integer' name='[Calculation_5100000000000000003]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT([date])' />
            </column>
            <column caption='Share with no warning' datatype='real' name='[Calculation_6200000000000000001]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG(IF [heat_warning] = 0 THEN 100.0 ELSE 0.0 END)' />
            </column>
            <column caption='No warning rate' datatype='string' name='[Calculation_6200000000000000002]' role='measure' type='nominal'>
              <calculation class='tableau' formula='STR(INT(ROUND([Calculation_6200000000000000001]))) + &quot;%&quot; + &quot; (&quot; + STR(SUM(IF [heat_warning] = 0 THEN 1 ELSE 0 END)) + &quot; of &quot; + STR(COUNT([date])) + &quot;)&quot;' />
            </column>
            <column caption='Date' datatype='date' name='[date]' role='dimension' type='ordinal' />
            <column caption='Heat warning (0/1)' datatype='integer' name='[heat_warning]' role='measure' type='quantitative' />
            <column-instance column='[temp_band]' derivation='None' name='[none:temp_band:nk]' pivot='key' type='nominal' />
            <column-instance column='[year]' derivation='None' name='[none:year:ok]' pivot='key' type='ordinal' />
            <column caption='Temperature band (°C)' datatype='string' name='[temp_band]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_5100000000000000003]' derivation='User' name='[usr:Calculation_5100000000000000003:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_6200000000000000001]' derivation='User' name='[usr:Calculation_6200000000000000001:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_6200000000000000002]' derivation='User' name='[usr:Calculation_6200000000000000002:nk]' pivot='key' type='nominal' />
            <column caption='Year' datatype='integer' name='[year]' role='dimension' type='ordinal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0e9422g07f646911m3q6z16lejz5].[none:temp_band:nk]'>
            <groupfilter function='union'>
              <groupfilter function='member' level='[none:temp_band:nk]' member='&quot;30–32&quot;' />
              <groupfilter function='member' level='[none:temp_band:nk]' member='&quot;32–34&quot;' />
              <groupfilter function='member' level='[none:temp_band:nk]' member='&quot;34+&quot;' />
            </groupfilter>
          </filter>
          <slices>
            <column>[federated.0e9422g07f646911m3q6z16lejz5].[none:temp_band:nk]</column>
          </slices>
          <aggregation value='true' />
